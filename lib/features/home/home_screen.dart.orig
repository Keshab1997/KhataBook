// Flutter 3.50 deprecates this import; migrate to material_ui in a dedicated dependency update.
// ignore: deprecated_member_use
import 'package:flutter/material.dart';

import '../../core/l10n/app_strings.dart';
import '../../core/theme/app_colors.dart';
import '../entry/category_artwork.dart';
import '../entry/category_picker.dart';
import '../entry/category_store.dart';
import 'models.dart';

/// Geometry shared by every card on this screen: one card radius, one row
/// radius and one hairline keep the hero, the tiles and the recent rows
/// reading as a single system.
const double _cardRadius = 20;
const double _rowRadius = 16;
const double _hairline = 0.72;

/// S1 - Home / My Khata. See docs/spec/screens.md#s1--home--my-khata.
///
/// A presentational seam: the parent supplies a live [summary] and the
/// [onAddEntry] / [onViewAll] callbacks. With no [summary] the screen shows
/// clearly labelled sample figures. It reads no storage and holds no state.
///
/// The layout gives the active ledger and remaining balance first priority,
/// then keeps the income/expense split, recent activity and primary action
/// close together. Illustrations are local assets: the screen works offline.
class HomeScreen extends StatelessWidget {
  const HomeScreen({
    super.key,
    this.language = AppLanguage.en,
    this.summary,
    this.onAddEntry,
    this.onViewAll,
    this.khataName,
    this.onSwitchKhata,
    this.categoryStore,
    this.onSettings,
  });

  final AppLanguage language;
  final CategoryStore? categoryStore;
  final VoidCallback? onSettings;

  AppStrings get _strings => AppStrings(language);

  /// Live figures to render. `null` selects the seeded sample preview.
  final LedgerSummary? summary;

  /// CTA action; a null callback leaves the button visibly disabled.
  final VoidCallback? onAddEntry;

  /// *View All* action; a null callback leaves that affordance disabled.
  final VoidCallback? onViewAll;

  final String? khataName;
  final VoidCallback? onSwitchKhata;

  static const double _pagePadding = 16;
  static const double _cardGap = 12;

  @override
  Widget build(BuildContext context) {
    final bool preview = summary == null;
    final LedgerSummary visibleSummary =
        summary ??
        LedgerSummary(
          openingBalancePaise: kSeedOpeningBalancePaise,
          entries: kSeedEntries,
        );
    final List<LedgerEntry> recent = visibleSummary.recent();

    return Scaffold(
      bottomNavigationBar: SafeArea(
        top: false,
        child: Container(
          padding: const EdgeInsets.fromLTRB(
            _pagePadding,
            10,
            _pagePadding,
            10,
          ),
          decoration: BoxDecoration(
            color: AppColors.creamBackground,
            image: const DecorationImage(
              image: AssetImage('assets/illustrations/home_landscape.png'),
              fit: BoxFit.cover,
              alignment: Alignment.bottomCenter,
            ),
            border: Border(
              top: BorderSide(color: AppColors.outline.withValues(alpha: 0.55)),
            ),
            boxShadow: <BoxShadow>[
              BoxShadow(
                color: AppColors.darkText.withValues(alpha: 0.05),
                blurRadius: 14,
                offset: const Offset(0, -4),
              ),
            ],
          ),
          child: FilledButton.icon(
            key: const Key('home-add-entry'),
            onPressed: onAddEntry,
            style: FilledButton.styleFrom(
              backgroundColor: AppColors.primaryGreen,
              minimumSize: const Size.fromHeight(56),
              shape: const StadiumBorder(),
            ),
            icon: const Icon(Icons.add, size: 30),
            label: Text(
              _strings.text(AppString.addNewEntry),
              style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w700),
            ),
          ),
        ),
      ),
      body: SafeArea(
        bottom: false,
        child: Column(
          children: <Widget>[
            Expanded(
              child: SingleChildScrollView(
                padding: const EdgeInsets.fromLTRB(
                  _pagePadding,
                  12,
                  _pagePadding,
                  20,
                ),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: <Widget>[
                    if (khataName != null || onSwitchKhata != null) ...<Widget>[
                      _ActiveKhataCard(
                        strings: _strings,
                        name:
                            khataName ?? _strings.text(AppString.personalKhata),
                        onTap: onSwitchKhata,
                        onSettings: onSettings,
                      ),
                      const SizedBox(height: _cardGap),
                    ],
                    _BalanceCard(
                      strings: _strings,
                      remainingPaise: visibleSummary.remainingPaise,
                    ),
                    const SizedBox(height: _cardGap),
                    _summaryRow(visibleSummary),
                    const SizedBox(height: 20),
                    _SectionHeader(
                      strings: _strings,
                      title: _strings.text(AppString.recentTransactions),
                      onViewAll: onViewAll,
                    ),
                    const SizedBox(height: 8),
                    if (recent.isEmpty)
                      _EmptyTransactions(_strings)
                    else
                      for (final LedgerEntry entry in recent)
                        if (categoryStore == null)
                          _RecentTransactionRow(
                            strings: _strings,
                            entry: entry,
                            preview: preview,
                          )
                        else
                          CategoryCatalog(
                            store: categoryStore!,
                            builder: (context, categories) =>
                                _RecentTransactionRow(
                                  strings: _strings,
                                  entry: entry,
                                  preview: preview,
                                  categories: categories,
                                ),
                          ),
                    const SizedBox(height: 4),
                    if (preview) ...<Widget>[
                      const SizedBox(height: 10),
                      Center(
                        child: Text(
                          _strings.text(AppString.homePreview),
                          textAlign: TextAlign.center,
                          style: const TextStyle(
                            color: AppColors.softText,
                            fontSize: 11,
                            letterSpacing: 0.2,
                          ),
                        ),
                      ),
                    ],
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _summaryRow(LedgerSummary summary) {
    return IntrinsicHeight(
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: <Widget>[
          Expanded(
            child: _SummaryTile(
              strings: _strings,
              label: _strings.text(AppString.totalIncome),
              paise: summary.totalIncomePaise,
              color: AppColors.incomeGreen,
              icon: Icons.south_rounded,
              direction: _strings.text(AppString.income).toLowerCase(),
            ),
          ),
          const SizedBox(width: _cardGap),
          Expanded(
            child: _SummaryTile(
              strings: _strings,
              label: _strings.text(AppString.totalExpense),
              paise: summary.totalExpensePaise,
              color: AppColors.expenseRed,
              icon: Icons.north_east_rounded,
              direction: _strings.text(AppString.expense).toLowerCase(),
            ),
          ),
        ],
      ),
    );
  }
}

/// An always-visible switcher row makes the active ledger easy to confirm.
class _ActiveKhataCard extends StatelessWidget {
  const _ActiveKhataCard({
    required this.strings,
    required this.name,
    required this.onTap,
    this.onSettings,
  });

  final AppStrings strings;
  final String name;
  final VoidCallback? onTap;
  final VoidCallback? onSettings;

  @override
  Widget build(BuildContext context) {
    return Row(
      children: <Widget>[
        Expanded(
          child: Semantics(
            key: const Key('switch-khata'),
            button: onTap != null,
            enabled: onTap != null,
            label:
                '$name, ${strings.text(AppString.activeKhata)}${onTap == null ? '' : ', ${strings.text(AppString.tapToSwitch)}'}',
            onTap: onTap,
            excludeSemantics: true,
            child: Material(
              color: AppColors.surface,
              borderRadius: BorderRadius.circular(32),
              child: InkWell(
                onTap: onTap,
                borderRadius: BorderRadius.circular(32),
                child: Padding(
                  padding: const EdgeInsets.all(8),
                  child: Row(
                    children: <Widget>[
                      ClipOval(
                        child: Image.asset(
                          'assets/illustrations/home_brand.png',
                          width: 62,
                          height: 62,
                          fit: BoxFit.cover,
                        ),
                      ),
                      const SizedBox(width: 10),
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          mainAxisSize: MainAxisSize.min,
                          children: <Widget>[
                            Text(
                              strings.text(AppString.activeKhata).toUpperCase(),
                              maxLines: 1,
                              overflow: TextOverflow.ellipsis,
                              style: const TextStyle(
                                fontSize: 10,
                                color: AppColors.primaryGreen,
                                fontWeight: FontWeight.w700,
                              ),
                            ),
                            Row(
                              children: <Widget>[
                                Expanded(
                                  child: Text(
                                    name,
                                    maxLines: 1,
                                    overflow: TextOverflow.ellipsis,
                                    style: const TextStyle(
                                      fontSize: 19,
                                      color: AppColors.headerGreen,
                                      fontWeight: FontWeight.w800,
                                    ),
                                  ),
                                ),
                                const Icon(
                                  Icons.keyboard_arrow_down_rounded,
                                  color: AppColors.headerGreen,
                                ),
                              ],
                            ),
                            const Text(
                              'Plan • Track • Save',
                              maxLines: 1,
                              overflow: TextOverflow.ellipsis,
                              style: TextStyle(
                                fontStyle: FontStyle.italic,
                                fontSize: 12,
                                color: AppColors.headerGreen,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
          ),
        ),
        if (onSettings != null) ...<Widget>[
          const SizedBox(width: 8),
          Material(
            color: AppColors.primaryGreen,
            shape: const CircleBorder(),
            child: IconButton(
              onPressed: onSettings,
              tooltip: 'Settings',
              color: AppColors.onPrimary,
              icon: const Icon(Icons.settings),
            ),
          ),
        ],
      ],
    );
  }
}

/// Green balance card with a bundled AI wallet illustration.
class _BalanceCard extends StatelessWidget {
  const _BalanceCard({required this.strings, required this.remainingPaise});

  final AppStrings strings;
  final int remainingPaise;

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        gradient: const LinearGradient(
          colors: <Color>[AppColors.primaryGreen, AppColors.headerGreen],
        ),
        borderRadius: BorderRadius.circular(32),
        border: const Border(
          bottom: BorderSide(color: AppColors.golden, width: 3),
        ),
        boxShadow: <BoxShadow>[
          BoxShadow(
            color: AppColors.darkText.withValues(alpha: 0.16),
            blurRadius: 14,
            offset: const Offset(0, 6),
          ),
        ],
      ),
      child: ClipRRect(
        borderRadius: BorderRadius.circular(30),
        child: Padding(
          padding: const EdgeInsets.symmetric(vertical: 14, horizontal: 12),
          child: Row(
            children: <Widget>[
              ExcludeSemantics(
                child: ClipRRect(
                  borderRadius: BorderRadius.circular(14),
                  child: Image.asset(
                    'assets/illustrations/home_balance_wallet.png',
                    width: 68,
                    height: 78,
                    fit: BoxFit.cover,
                  ),
                ),
              ),
              Container(
                width: 1,
                height: 68,
                margin: const EdgeInsets.symmetric(horizontal: 10),
                color: AppColors.golden,
              ),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  mainAxisSize: MainAxisSize.min,
                  children: <Widget>[
                    Text(
                      strings.text(AppString.remainingBalance),
                      maxLines: 2,
                      style: const TextStyle(
                        color: AppColors.onPrimary,
                        fontSize: 14,
                        fontWeight: FontWeight.w700,
                      ),
                    ),
                    const SizedBox(height: 6),
                    FittedBox(
                      fit: BoxFit.scaleDown,
                      alignment: Alignment.centerLeft,
                      child: Text(
                        strings.money(remainingPaise),
                        maxLines: 1,
                        style: const TextStyle(
                          color: AppColors.golden,
                          fontSize: 38,
                          fontWeight: FontWeight.w800,
                          height: 1.05,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
              const SizedBox(width: 4),
              ExcludeSemantics(
                child: ClipOval(
                  child: Image.asset(
                    'assets/illustrations/home_balance_book.png',
                    width: 85,
                    height: 85,
                    fit: BoxFit.cover,
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

/// One half of the income/expense summary row.
class _SummaryTile extends StatelessWidget {
  const _SummaryTile({
    required this.strings,
    required this.label,
    required this.paise,
    required this.color,
    required this.icon,
    required this.direction,
  });

  final AppStrings strings;
  final String label;
  final int paise;
  final Color color;
  final IconData icon;
  final String direction;

  @override
  Widget build(BuildContext context) {
    return Semantics(
      container: true,
      label: '$label, $direction, ${strings.money(paise)}',
      child: ExcludeSemantics(
        child: Container(
          padding: const EdgeInsets.symmetric(vertical: 12, horizontal: 12),
          decoration: BoxDecoration(
            color: AppColors.surface,
            borderRadius: BorderRadius.circular(_rowRadius + 2),
            border: Border.all(
              color: AppColors.outline.withValues(alpha: _hairline + 0.13),
            ),
            boxShadow: <BoxShadow>[
              BoxShadow(
                color: AppColors.darkText.withValues(alpha: 0.03),
                blurRadius: 8,
                offset: const Offset(0, 2),
              ),
            ],
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            mainAxisSize: MainAxisSize.min,
            children: <Widget>[
              Row(
                children: <Widget>[
                  Container(
                    width: 28,
                    height: 28,
                    decoration: BoxDecoration(
                      color: color.withValues(alpha: 0.13),
                      shape: BoxShape.circle,
                    ),
                    child: Icon(icon, size: 16, color: color),
                  ),
                  const SizedBox(width: 7),
                  Expanded(
                    child: Text(
                      label,
                      maxLines: 2,
                      style: const TextStyle(
                        fontSize: 12,
                        height: 1.2,
                        letterSpacing: 0.1,
                        color: AppColors.softText,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 8),
              FittedBox(
                fit: BoxFit.scaleDown,
                alignment: Alignment.centerLeft,
                child: Text(
                  strings.money(paise),
                  maxLines: 1,
                  softWrap: false,
                  style: TextStyle(
                    fontSize: 25,
                    height: 1.1,
                    letterSpacing: -0.3,
                    fontWeight: FontWeight.w800,
                    color: color,
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

/// Empty ledger state, kept plain and actionable.
class _EmptyTransactions extends StatelessWidget {
  const _EmptyTransactions(this.strings);

  final AppStrings strings;

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 26),
      decoration: BoxDecoration(
        color: AppColors.surface,
        borderRadius: BorderRadius.circular(_cardRadius),
        border: Border.all(
          color: AppColors.outline.withValues(alpha: _hairline + 0.13),
        ),
      ),
      child: Column(
        children: <Widget>[
          Image.asset(
            'assets/illustrations/home_brand.png',
            width: 80,
            height: 80,
          ),
          Container(
            width: 52,
            height: 52,
            decoration: const BoxDecoration(
              color: AppColors.lightGreen,
              shape: BoxShape.circle,
            ),
            child: const Icon(
              Icons.receipt_long_rounded,
              color: AppColors.primaryGreen,
              size: 26,
            ),
          ),
          const SizedBox(height: 12),
          Text(
            strings.text(AppString.homeEmpty),
            textAlign: TextAlign.center,
            style: const TextStyle(
              color: AppColors.softText,
              fontSize: 13,
              height: 1.4,
            ),
          ),
        ],
      ),
    );
  }
}

/// *Recent Transactions* with an accessible `View All` button.
class _SectionHeader extends StatelessWidget {
  const _SectionHeader({
    required this.strings,
    required this.title,
    this.onViewAll,
  });

  final AppStrings strings;
  final String title;
  final VoidCallback? onViewAll;

  @override
  Widget build(BuildContext context) {
    final bool enabled = onViewAll != null;
    final Color tint = enabled
        ? AppColors.primaryGreen
        : AppColors.navigationGrey;

    return Row(
      children: <Widget>[
        Container(
          width: 4,
          height: 18,
          decoration: BoxDecoration(
            color: enabled
                ? AppColors.primaryGreen
                : AppColors.navigationGrey.withValues(alpha: 0.6),
            borderRadius: BorderRadius.circular(2),
          ),
        ),
        const SizedBox(width: 8),
        Expanded(
          child: Text(
            title,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: const TextStyle(
              fontSize: 17,
              fontWeight: FontWeight.w800,
              color: AppColors.darkText,
              letterSpacing: -0.2,
            ),
          ),
        ),
        const SizedBox(width: 8),
        Flexible(
          child: FittedBox(
            fit: BoxFit.scaleDown,
            alignment: Alignment.centerRight,
            child: TextButton(
              onPressed: onViewAll,
              style: TextButton.styleFrom(
                padding: const EdgeInsets.symmetric(horizontal: 8),
                minimumSize: const Size(44, 44),
                tapTargetSize: MaterialTapTargetSize.shrinkWrap,
                foregroundColor: tint,
                backgroundColor: AppColors.lightGreen,
                shape: const StadiumBorder(),
              ),
              child: Row(
                mainAxisSize: MainAxisSize.min,
                children: <Widget>[
                  Text(
                    strings.text(AppString.viewAll),
                    style: TextStyle(
                      fontSize: 13,
                      fontWeight: FontWeight.w700,
                      color: tint,
                    ),
                  ),
                  Icon(Icons.chevron_right_rounded, size: 18, color: tint),
                ],
              ),
            ),
          ),
        ),
      ],
    );
  }
}

/// One recent transaction: category cue, clear description and signed amount.
class _RecentTransactionRow extends StatelessWidget {
  const _RecentTransactionRow({
    required this.strings,
    required this.entry,
    required this.preview,
    this.categories,
  });

  final AppStrings strings;
  final LedgerEntry entry;
  final bool preview;
  final List<CustomCategory>? categories;

  @override
  Widget build(BuildContext context) {
    final bool isIncome = entry.type == EntryType.income;
    final Color amountColor = isIncome
        ? AppColors.incomeGreen
        : AppColors.expenseRed;

    // The stored category is translated for display only; the title is the
    // user's own text and is never touched.
    final String categoryName = categories == null
        ? _categoryLabel(strings, entry.category)
        : categoryDisplayName(strings.language, entry.category, categories!);
    final String title = preview
        ? _previewTitle(strings, entry.title)
        : (categories != null && entry.title == entry.category
              ? categoryName
              : entry.title);

    return Container(
      margin: const EdgeInsets.only(bottom: 8),
      padding: const EdgeInsets.symmetric(vertical: 13, horizontal: 12),
      decoration: BoxDecoration(
        color: AppColors.surface,
        borderRadius: BorderRadius.circular(_rowRadius),
        border: Border.all(
          color: AppColors.outline.withValues(alpha: _hairline),
        ),
        boxShadow: <BoxShadow>[
          BoxShadow(
            color: AppColors.darkText.withValues(alpha: 0.03),
            blurRadius: 8,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: Row(
        children: <Widget>[
          Semantics(
            label: strings.categoryLabel(categoryName),
            child: Container(
              width: 40,
              height: 40,
              decoration: BoxDecoration(
                color: _categoryTint(entry.category),
                shape: BoxShape.circle,
              ),
              child: ClipOval(
                child: CategoryArtwork(
                  category: entry.category,
                  size: 40,
                  fallbackColor: _categoryColor(entry.category),
                  customCategory: categories == null
                      ? null
                      : findCustomCategory(entry.category, categories!),
                ),
              ),
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            flex: 3,
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              mainAxisSize: MainAxisSize.min,
              children: <Widget>[
                Text(
                  title,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                    fontSize: 14,
                    height: 1.2,
                    fontWeight: FontWeight.w700,
                    color: AppColors.darkText,
                  ),
                ),
                // The category is only repeated when it adds information, so
                // a row never shows the same words twice.
                if (categories != null && categoryName != title) ...<Widget>[
                  const SizedBox(height: 1),
                  Text(
                    categoryName,
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(
                      fontSize: 11.5,
                      height: 1.2,
                      color: AppColors.softText,
                      fontWeight: FontWeight.w500,
                    ),
                  ),
                ],
                const SizedBox(height: 2),
                Text(
                  strings.dateTime(entry.at),
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                    fontSize: 11.5,
                    height: 1.2,
                    color: AppColors.softText,
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(width: 8),
          Flexible(
            flex: 2,
            child: Align(
              alignment: Alignment.centerRight,
              child: FittedBox(
                fit: BoxFit.scaleDown,
                alignment: Alignment.centerRight,
                child: Text(
                  isIncome
                      ? '+${strings.money(entry.amountPaise)}'
                      : strings.money(entry.amountPaise),
                  maxLines: 1,
                  softWrap: false,
                  style: TextStyle(
                    fontSize: 18,
                    height: 1.15,
                    letterSpacing: -0.2,
                    fontWeight: FontWeight.w800,
                    color: amountColor,
                  ),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Color _categoryTint(String category) =>
      _categoryColor(category).withValues(alpha: 0.14);

  /// Category colours come from theme tokens only.
  Color _categoryColor(String category) {
    switch (category) {
      case 'Shopping':
        return AppColors.primaryGreen;
      case 'Food':
        return AppColors.orange;
      case 'Travel':
        return AppColors.secondaryGreen;
      case 'Bills':
        return AppColors.golden;
      case 'Gifts':
        return AppColors.expenseRed;
      default:
        return AppColors.navigationGrey;
    }
  }
}

String _categoryLabel(AppStrings strings, String category) {
  final AppString? key = switch (category) {
    'Shopping' => AppString.shopping,
    'Food' => AppString.food,
    'Travel' => AppString.travel,
    'Bills' => AppString.bills,
    'Gifts' => AppString.gifts,
    'Income' => AppString.income,
    'Expense' => AppString.expense,
    _ => null,
  };
  return key == null ? category : strings.text(key);
}

String _previewTitle(AppStrings strings, String title) {
  final AppString? key = switch (title) {
    'Grocery Shopping' => AppString.groceryShopping,
    'Lunch with Friends' => AppString.lunchWithFriends,
    'Mobile Recharge' => AppString.mobileRecharge,
    'Gift for Mom' => AppString.giftForMom,
    'Bus Fare' => AppString.busFare,
    'Tea with Team' => AppString.teaWithTeam,
    _ => null,
  };
  return key == null ? title : strings.text(key);
}
